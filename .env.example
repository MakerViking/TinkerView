# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ---- Images (VERIFY the current stable Frigate tag before deploy) -----------
# https://github.com/blakeblackshear/frigate/releases
FRIGATE_IMAGE=ghcr.io/blakeblackshear/frigate:0.17.1
FRIGATE_IMAGE_ROCM=ghcr.io/blakeblackshear/frigate:0.17.1-rocm
MOSQUITTO_IMAGE=eclipse-mosquitto:2.0.22

# ---- Timezone & storage ----------------------------------------------------
TZ=Europe/Amsterdam
# Where recordings/clips/snapshots live. On Unraid point at the array/cache,
# e.g. /mnt/user/frigate. Default is a local ./storage/frigate folder.
STORAGE_PATH=./storage/frigate
# Shared memory for decoded frames — raise as you add cameras (see Frigate docs).
FRIGATE_SHM_SIZE=256mb

# ---- Camera credentials ----------------------------------------------------
# Referenced in frigate/config.yml as {FRIGATE_RTSP_USER} / {FRIGATE_RTSP_PASSWORD}.
FRIGATE_RTSP_USER=admin
FRIGATE_RTSP_PASSWORD=changeme

# Allow go2rtc `exec:` sources. OFF by default, and the dashboard works fully
# without it. Turn it on ONLY for the optional GPU-enhanced "<cam>_hq" streams you
# write yourself in frigate/config.yml (see the commented example there).
# SECURITY: while this is true, anyone who can reach go2rtc's API (port 1984 on
# the host) can run commands inside the Frigate container. Keep 1984 off any
# untrusted network (firewall it, or use compose.bridge.yml which binds it to
# localhost). See SECURITY.md.
GO2RTC_ALLOW_ARBITRARY_EXEC=false

# ---- Windows / bridge networking ONLY --------------------------------------
# This machine's LAN IP, used for the go2rtc WebRTC candidate (referenced in
# frigate/config.yml). Ignored on host-networking hosts (Unraid/Pi).
FRIGATE_HOST_LAN_IP=192.168.1.10

# ---- Control dashboard -----------------------------------------------------
DASHBOARD_IMAGE=tinkerview:latest
# Shared bearer token gating the dashboard API + ntfy action buttons. SET ONE:
# with it empty, anyone who can reach port 8088 has full control (the dashboard
# logs a warning at startup). Generate one:  openssl rand -hex 24
# (install.sh does this for you.) When set, open the dashboard once as
# http://<host>:8088/?token=<your token>; the browser stores it and uses it for
# the API + WebSocket thereafter.
DASHBOARD_TOKEN=
# Docker access for container health/restart — the docker-socket-proxy endpoint.
# (Named DASHBOARD_DOCKER_HOST so it cannot collide with the DOCKER_HOST your shell or
# `podman compose` sets for the compose tool itself. The dashboard sees it as DOCKER_HOST.)
DASHBOARD_DOCKER_HOST=tcp://127.0.0.1:2375
# 0 (default) = read-only container health view; the Restart button is disabled.
# 1 = the dashboard may restart containers. The proxy cannot restrict POST to
# "restart" only, so 1 is root-equivalent for anything that can reach 127.0.0.1:2375
# (loopback only). Opt in only if you want the button. See SECURITY.md.
DOCKERPROXY_POST=0
# Host path of the container engine's API socket, mounted into docker-socket-proxy.
# Leave it unset on Docker. Rootless podman: install.sh sets it to your user socket,
# for example /run/user/1000/podman/podman.sock.
# DOCKER_SOCKET_PATH=/var/run/docker.sock
# Address the dashboard listens on (default ":8088" = all interfaces). Bind to a
# single IP (e.g. your tailnet or LAN address) to narrow it.
# DASHBOARD_LISTEN=:8088

# ---- MQTT (Mosquitto) ------------------------------------------------------
# By default the broker is published on 127.0.0.1 only. For Home Assistant on
# another machine use compose.mqtt-lan.yml (password-protected, port 1884);
# this limits which interface that port binds to (default: all).
# MQTT_LAN_BIND=0.0.0.0

# ---- ntfy (push notifications) ---------------------------------------------
NTFY_IMAGE=binwiederhier/ntfy:v2.11.0
NTFY_BASE_URL=http://127.0.0.1:8092
# ntfy relays a content-free poll request (a hash of the topic, no message) to ntfy.sh so
# iOS gets instant push. Uncomment with an empty value to switch that off (Android is
# unaffected; iOS notifications then arrive late or not at all).
# NTFY_UPSTREAM_BASE_URL=
# Publish token the dashboard uses (create it in ntfy after first start).
NTFY_TOKEN=

DOCKERPROXY_IMAGE=tecnativa/docker-socket-proxy:0.3.0

# ---- Tailscale sidecar (compose.tailscale.yml, optional) -------------------
# Auth key from the Tailscale admin console (Settings > Keys). Without it the
# container prints a login URL in its logs instead.
# TS_AUTHKEY=
